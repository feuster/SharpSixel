<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.4.0</Version>
    <PackRelease>true</PackRelease>
    <PublishRelease>true</PublishRelease>
    <Product>SharpSixel</Product>
    <Authors>Alexander Feuster</Authors>
    <Copyright>Copyright (c) 2026 Alexander Feuster</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/feuster/SharpSixel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/feuster/SharpSixel</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Symbols (.snupkg) and SourceLink (built into the .NET SDK, GitHub) for debugging into the packages. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
